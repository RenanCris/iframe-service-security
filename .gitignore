# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Arquivos de Diagnóstico e Dump de Memória
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
core
*.cpuprofile
*.heapprofile
*.heapsnapshot

# Dependências (Nunca envie a pasta node_modules para o Git)
node_modules/
jspm_packages/
web_modules/

# Arquivos de Build, Saída e Cache (Ex: TypeScript, Next.js, Nuxt, etc.)
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Arquivos de Configuração de Variáveis de Ambiente (Segurança)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Arquivos específicos do Yarn (Se usar Yarn 2+)
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Arquivos de Testes e Cobertura de Código
coverage/
.nyc_output/
.jest/
cypress/videos/
cypress/screenshots/

# Configurações de editores de código (Opcional, mas recomendado)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Arquivos de Sistema Operacional (Lixo do sistema)
.DS_Store
Thumbs.db
.claude/
